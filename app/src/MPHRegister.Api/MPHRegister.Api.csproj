<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>MPH Register</AssemblyName>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <RootNamespace>MPHRegister.Api</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MPHRegister.Contracts\MPHRegister.Contracts.csproj" />
    <ProjectReference Include="..\MPHRegister.Data\MPHRegister.Data.csproj" />
    <ProjectReference Include="..\MPHRegister.Services\MPHRegister.Services.csproj" />
    <ProjectReference Include="..\MPHRegister.Shared\MPHRegister.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MPHRegister.UnitTests" />
  </ItemGroup>
</Project>
