#!/bin/sh
# Refuses a commit message that names a real party or carries the firm's details (scripts/privacy_check.py).
top=$(git rev-parse --show-toplevel)
py=$(command -v python3 || command -v python) || { echo "privacy: python 3 is needed to check the message." >&2; exit 1; }
exec "$py" "$top/scripts/privacy_check.py" --message "$1"
